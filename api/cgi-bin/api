#!/bin/sh

# EdgeNode 本地只读 API (CGI) 0.1.5
# 仅接受 GET/HEAD + Bearer Token；不提供 Shell 或任意命令执行能力。
# HEAD 与 GET 走完全相同的流程，只是不输出响应体（Content-Length 保持一致）。

PATH=/usr/sbin:/usr/bin:/sbin:/bin

TOKEN_FILE="${EN_TOKEN_FILE:-/overlay/edgenode/etc/api.token}"
AGENT="${EN_AGENT:-/overlay/edgenode/bin/edgenode-agent}"
# jsonfilter 是 OpenWrt base 自带组件（ubox）。允许覆盖仅为测试。
JSONFILTER="${EN_JSONFILTER:-jsonfilter}"

REQUEST_METHOD="${REQUEST_METHOD:-}"
PATH_INFO="${PATH_INFO:-}"
AUTH_HEADER="${HTTP_AUTHORIZATION:-${REDIRECT_HTTP_AUTHORIZATION:-}}"

respond() {
    code="$1"
    message="$2"
    # 可选的附加响应头（每条一行，不含结尾 CRLF），目前仅 405 使用。
    extra_headers="${3:-}"

    # 必须与 GET 时实际输出的字节数一致（printf 会补一个换行）。
    # HEAD 只省略响应体，长度仍按完整 body 计算，故先算长度再决定是否打印。
    length=$(printf '%s\n' "$message" | wc -c | tr -d ' ')

    printf 'Status: %s\r\n' "$code"
    printf 'Content-Type: application/json\r\n'
    printf 'Content-Length: %s\r\n' "$length"
    printf 'Cache-Control: no-store\r\n'
    printf 'X-Content-Type-Options: nosniff\r\n'
    if [ -n "$extra_headers" ]; then
        printf '%s\r\n' "$extra_headers"
    fi
    printf '\r\n'

    if [ "$REQUEST_METHOD" != "HEAD" ]; then
        printf '%s\n' "$message"
    fi
}

# 单次响应；成功路径也必须带 Content-Length。
respond_ok() {
    respond "200 OK" "$1"
}

internal_error() {
    # 对外不区分"Token 文件缺失"与"Agent 执行失败"，细节只写服务端日志。
    printf 'edgenode-api: internal error: %s\n' "$1" >&2
    respond "500 Internal Server Error" '{"error":"internal_error"}'
}

hash_token() {
    printf '%s' "$1" | md5sum 2>/dev/null | awk '{print $1; exit}'
}

token_matches() {
    provided="$1"
    expected="$2"

    ph=$(hash_token "$provided")
    eh=$(hash_token "$expected")

    if [ -n "$ph" ] && [ -n "$eh" ]; then
        # 比较摘要而不是明文，避免按前缀逐字节比较带来的计时差异。
        [ "$ph" = "$eh" ]
        return $?
    fi

    [ "$provided" = "$expected" ]
}

case "$REQUEST_METHOD" in
    GET|HEAD)
        ;;
    *)
        respond "405 Method Not Allowed" '{"error":"method_not_allowed"}' 'Allow: GET, HEAD'
        exit 0
        ;;
esac

if [ ! -s "$TOKEN_FILE" ]; then
    internal_error "token file missing or empty"
    exit 0
fi

case "$AUTH_HEADER" in
    "Bearer "*)
        PROVIDED_TOKEN="${AUTH_HEADER#Bearer }"
        ;;
    *)
        respond "401 Unauthorized" '{"error":"unauthorized"}'
        exit 0
        ;;
esac

EXPECTED_TOKEN="$(cat "$TOKEN_FILE")"

if ! token_matches "$PROVIDED_TOKEN" "$EXPECTED_TOKEN"; then
    respond "401 Unauthorized" '{"error":"unauthorized"}'
    exit 0
fi

case "$PATH_INFO" in
    ""|"/")
        API_PATH="/status"
        ;;
    "/v1/status")
        API_PATH="/status"
        ;;
    "/v1/device")
        API_PATH="/device"
        ;;
    "/v1/system")
        API_PATH="/system"
        ;;
    "/v1/network")
        API_PATH="/network"
        ;;
    "/v1/zerotier")
        API_PATH="/zerotier"
        ;;
    *)
        respond "404 Not Found" '{"error":"not_found"}'
        exit 0
        ;;
esac

if [ ! -x "$AGENT" ]; then
    internal_error "agent not executable: $AGENT"
    exit 0
fi

AGENT_JSON="$("$AGENT" 2>/dev/null)"

if [ -z "$AGENT_JSON" ]; then
    internal_error "agent produced no output"
    exit 0
fi

case "$API_PATH" in
    "/status")
        RESULT="$AGENT_JSON"
        ;;
    "/device")
        RESULT="$(printf '%s' "$AGENT_JSON" | "$JSONFILTER" -e '@.device' 2>/dev/null)"
        ;;
    "/system")
        RESULT="$(printf '%s' "$AGENT_JSON" | "$JSONFILTER" -e '@.system' 2>/dev/null)"
        ;;
    "/network")
        RESULT="$(printf '%s' "$AGENT_JSON" | "$JSONFILTER" -e '@.network' 2>/dev/null)"
        ;;
    "/zerotier")
        RESULT="$(printf '%s' "$AGENT_JSON" | "$JSONFILTER" -e '@.network.zerotier' 2>/dev/null)"
        ;;
esac

if [ -z "$RESULT" ]; then
    internal_error "invalid agent data for path $API_PATH"
    exit 0
fi

respond_ok "$RESULT"

exit 0
