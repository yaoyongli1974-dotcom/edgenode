#!/bin/sh

# EdgeNode Agent 0.1.3
# Platform: OpenWrt / BusyBox ash

PATH=/usr/sbin:/usr/bin:/sbin:/bin

get_interface() {
    ip -4 -o addr show dev "$1" 2>/dev/null |
        awk '{print $4; exit}'
}

get_load() {
    awk '{print $1}' /proc/loadavg
}

get_memory() {
    awk '
    /^MemTotal:/ {total=$2}
    /^MemAvailable:/ {available=$2}
    END {
        printf "{\"total_kb\":%d,\"available_kb\":%d}",
        total,available
    }' /proc/meminfo
}

get_storage() {
    df -k / 2>/dev/null | awk '
    NR==2 {
        printf "{\"total_kb\":%d,\"used_kb\":%d,\"available_kb\":%d}",
        $2,$3,$4
    }'
}

get_zerotier() {
    /usr/bin/zerotier-cli listnetworks 2>/dev/null |
    awk '
    $1=="200" && $2=="listnetworks" {
        if (length($3)!=16 || tolower($3) !~ /^[0-9a-f]+$/)
            next

        if ($6=="OK") {
            nwid=$3
            name=$4
            mac=$5
            status=$6
            type=$7
            dev=$8
            ips=$9
        }
        else if ($5=="NOT_FOUND") {
            nwid=$3
            name=""
            mac=$4
            status=$5
            type=$6
            dev=$7
            ips=$8
        }
        else {
            next
        }

        if (count++) printf ","

        printf "{"
        printf "\"network_id\":\"%s\",",nwid
        printf "\"name\":\"%s\",",name
        printf "\"mac\":\"%s\",",mac
        printf "\"status\":\"%s\",",status
        printf "\"type\":\"%s\",",type
        printf "\"interface\":\"%s\",",dev
        printf "\"ips\":\"%s\"",ips
        printf "}"
    }'
}

get_networks() {
    first=1

    for iface in $(ls /sys/class/net 2>/dev/null); do
        addr=$(get_interface "$iface")

        [ "$first" = 1 ] || printf ","
        first=0

        printf "{\"name\":\"%s\",\"ipv4\":\"%s\"}" "$iface" "$addr"
    done
}

get_cpu_model() {
    awk -F ': *' '/^cpu model/ {print $2; exit}' /proc/cpuinfo
}

get_device_model() {
    cat /tmp/sysinfo/model 2>/dev/null || echo "Unknown"
}

get_uptime() {
    awk '{printf "%d",$1}' /proc/uptime
}

get_timestamp() {
    date -u '+%Y-%m-%dT%H:%M:%SZ'
}

get_device_id() {
    IDFILE=/overlay/edgenode/etc/device-id

    if [ -s "$IDFILE" ]; then
        tr -d '\r\n' < "$IDFILE"
    else
        echo ""
    fi
}

get_version_info() {
    . /etc/openwrt_release
    RELEASE="$DISTRIB_RELEASE"
    ARCH="$DISTRIB_ARCH"
}

get_version_info

DEVICE_ID=$(get_device_id)
TIMESTAMP=$(get_timestamp)

echo "{"
echo "\"agent\":{\"name\":\"EdgeNode\",\"version\":\"0.1.3\"},"
echo "\"device\":{"
echo "\"device_id\":\"$DEVICE_ID\","
echo "\"model\":\"$(get_device_model)\","
echo "\"cpu\":\"$(get_cpu_model)\","
echo "\"architecture\":\"$ARCH\","
echo "\"firmware\":\"$RELEASE\""
echo "},"
echo "\"system\":{"
echo "\"timestamp\":\"$TIMESTAMP\","
echo "\"time_valid\":false,"
echo "\"uptime_seconds\":$(get_uptime),"
echo "\"load_1m\":$(get_load),"
echo "\"memory\":$(get_memory),"
echo "\"storage\":$(get_storage)"
echo "},"
echo "\"network\":{"
echo "\"interfaces\":[$(get_networks)],"
echo "\"zerotier\":[$(get_zerotier)]"
echo "}"
echo "}"
